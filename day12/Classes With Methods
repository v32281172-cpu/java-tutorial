import java.util.*;
class Arr{
    int a;
    int b;
    String c;
    String d;

    Array(int a){
        this.a=a;
    }
    void display(int a){
        System.out.println(a);
    }
    Array(int b){
        this.b=b;
    }
    void display(int b){
        System.out.println(b);
    }
    Array(String c,String d){
        this.c=c;
        this.d=d;
    }
    void display(String c,String d){
        System.out.println(c+" "+d);
    }
    Array(int a,int b){
        this.a=a;
        this.b=b;
    }
    void display(int a,int b){
        System.out.println(a+b);
    }
}
